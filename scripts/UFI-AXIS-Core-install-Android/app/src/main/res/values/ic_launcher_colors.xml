<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon colours — identical to :core, so the phone installer and the Core
  service read as one family. They are told apart by the badge glyph in the
  foreground vector (an install arrow instead of the "Core" text strip), not by colour.
  Kept as plain resources, not ui.theme tokens: the launcher renders this icon
  with no Compose composition in scope.
-->
<resources>
    <color name="ic_launcher_background">#F8FAFC</color>
    <color name="ic_launcher_glyph">#1E293B</color>
</resources>

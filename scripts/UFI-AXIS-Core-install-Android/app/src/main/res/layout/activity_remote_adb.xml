<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnBack"
                style="@style/Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/action_back" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/remote_adb_title" />
        </LinearLayout>

        <!-- 输入面板 -->
        <ScrollView
            android:id="@+id/panelInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_adb_title" />

                <TextView
                    style="@style/Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/remote_adb_sub" />

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remote_adb_label_address" />

                    <EditText
                        android:id="@+id/etAddress"
                        style="@style/Input.Address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/remote_adb_hint_address"
                        android:inputType="textUri" />

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/remote_adb_label_password" />

                    <EditText
                        android:id="@+id/etPassword"
                        style="@style/Input.Address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/remote_adb_hint_password"
                        android:inputType="textPassword" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStart"
                    style="@style/Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/remote_adb_start" />
            </LinearLayout>
        </ScrollView>

        <!-- 进度面板 -->
        <LinearLayout
            android:id="@+id/panelProgress"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.ufi_axis.installer.ui.RingProgressView
                android:id="@+id/ringProgress"
                android:layout_width="140dp"
                android:layout_height="140dp" />

            <TextView
                android:id="@+id/tvStage"
                style="@style/Text.Stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                tools:text="正在检测端口" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                tools:text="正在检测 5555 端口…" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/remote_adb_cancel" />
        </LinearLayout>

        <!-- 结果面板：内容比输入页多，小屏必须能滚动，否则底部按钮会被裁掉 -->
        <ScrollView
            android:id="@+id/panelResult"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvResultIcon"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textSize="42sp"
                android:textColor="@color/white_text"
                android:background="@drawable/bg_result_icon_success"
                tools:text="✓" />

            <TextView
                android:id="@+id/tvResultTitle"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                tools:text="远程 ADB 已开启" />

            <TextView
                android:id="@+id/tvResultSubtitle"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                tools:text="电脑端可执行下方命令进行无线调试。" />

            <LinearLayout
                android:id="@+id/cardResult"
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_device" />

                <TextView
                    android:id="@+id/tvResultAddr"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    tools:text="192.168.0.1:5555" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/divider" />

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/remote_adb_cmd_hint" />

                <TextView
                    android:id="@+id/tvResultCmd"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true"
                    android:fontFamily="monospace"
                    tools:text="adb connect 192.168.0.1:5555" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewLog"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_view_log" />

            <Button
                android:id="@+id/btnRetry"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/remote_adb_retry" />
        </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

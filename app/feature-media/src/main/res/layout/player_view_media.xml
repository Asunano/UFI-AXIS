<?xml version="1.0" encoding="utf-8"?>
<!-- 视频预览用 PlayerView：surface_type=texture_view 让视频走 TextureView，
     从而可被 Compose 的 clip(dialogShape) 裁成圆角（SurfaceView 无法被 Compose 裁剪，
     会戳出卡片圆角）。controller 使用自定义布局，把标题、关闭、全屏按钮都纳入 media3
     控制条，随控制器一起显示/隐藏。 -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:controller_layout_id="@layout/ufi_preview_player_controller"
    app:surface_type="texture_view"
    app:use_controller="true" />

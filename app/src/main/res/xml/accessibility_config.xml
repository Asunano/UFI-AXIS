<?xml version="1.0" encoding="utf-8"?>
<!--
  UFI-AXIS 通知守护无障碍服务配置（独立进程架构 v2 Phase 1）。

  设计要点：
  - canRetrieveWindowContent="false"：不读取任何窗口内容（纯保活用途，用户隐私最小化）；
  - packageNames 不限制：不设置 packageNames 属性，默认对全部应用生效（系统归类"特殊服务"，
    国产 ROM 后台管理豁免）；
  - accessibilityEventTypes 取最小集合 typeWindowStateChanged：仅需收到系统事件维持服务活跃，
    不处理任何事件内容（UfiNotifyAccessibilityService.onAccessibilityEvent 为空实现）。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_notify_guard_description"
    android:notificationTimeout="100" />

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 2026-08-09 19:51 告警通知增强：震动（channel vibrationPattern 必需）+ 锁屏全屏提醒（国产 ROM 部分机型） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 2026-08-10 独立通知进程 :ufi_notify（v2 Phase 1-3）：
         RECEIVE_BOOT_COMPLETED 开机自启；FOREGROUND_SERVICE + FOREGROUND_SERVICE_DATA_SYNC
         支撑 NotifyService 前台保活（Android 14+ dataSync 类型必需权限） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- NotifyService 后台兜底轮询期间短暂持有 PARTIAL_WAKE_LOCK（无此权限 acquire() 抛 SecurityException，轮询会静默失效） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".UfiAxisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UFIAXIS"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">
        <!-- enableOnBackInvokedCallback（2026-09-04 显式声明）：
             可预测性手势返回。targetSdk 36 下系统默认为开，但**不写**意味着
             ① 一旦 targetSdk 降回 ≤35 就静默失效；
             ② manifest merge 时若某个依赖带进 false，也没人察觉。
             NavHost 侧的转场已全部是 seekable 的位移（见 Navigation.kt），配合本开关
             手势预览才会跟着手指进度走。
             注意：`SmsScreen` 里那个条件 BackHandler 会吞掉系统返回，会话页没有手势预览。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.UFIAXIS"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ═══════════════════ :ufi_notify 独立通知进程（v2 Phase 1） ═══════════════════
             同一 APK 内的第二个进程（android:process=":ufi_notify"），只负责通知分发 + 保活，
             不加载 Compose UI / ViewModel（内存 8-15MB，唤醒 <50ms）。 -->
        <service
            android:name=".notification.NotifyService"
            android:process=":ufi_notify"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".notification.UfiNotifyAccessibilityService"
            android:process=":ufi_notify"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
        <receiver
            android:name=".notification.NotifyBootReceiver"
            android:process=":ufi_notify"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 覆盖安装后进程被杀，需重新拉起守护服务（否则用户不手动开 App 就收不到通知） -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 系统通知跨进程转交：主进程把告警交给 :ufi_notify 统一发射，去重游标单写者。
             显式 Intent + exported=false；本接收器会在需要时自动拉起 :ufi_notify 进程。 -->
        <receiver
            android:name="com.ufi_axis.data.notification.NotifyDispatchReceiver"
            android:process=":ufi_notify"
            android:exported="false" />

        <!-- 移除 WorkManager 的默认启动初始化器（2026-08-31）。
             UfiAxisApplication 实现了 Configuration.Provider（按需初始化 WorkManager），
             与 WorkManagerInitializer 的自动初始化二者只能留一个；同时存在时
             lint 的 RemoveWorkManagerInitializer 会判为 fatal，release / benchmark 构建直接失败，
             运行期也会白做一次进程启动初始化（:ufi_notify 进程同样会被触发）。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

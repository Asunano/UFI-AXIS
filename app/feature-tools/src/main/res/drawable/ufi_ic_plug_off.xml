<?xml version="1.0" encoding="utf-8"?>
<!--
    插头 + 断开（Tabler Icons: `plug-off`，MIT License）。

    为什么不用 Material 图标：material-icons-extended 里没有"插头"这一族，
    最接近的 LinkOff / PowerOff 在 21dp 下都读不出"断开一路连接"的意思。
    这里按用户提供的 SVG 逐条转成 VectorDrawable（描边图形，非填充），
    颜色写死为 #FF000000 —— 实际着色由调用方的 `Icon(tint = …)` 统一覆盖，
    因此明暗主题、皮肤色都能跟随。

    源 SVG（24×24，stroke-width 2，round cap/join）:
      M16.123 16.092l-.177 .177a5.81 5.81 0 1 1 -8.215 -8.215l.159 -.159
      M4 20l3.5 -3.5 / M15 4l-3.5 3.5 / M20 9l-3.5 3.5 / M3 3l18 18
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M16.123,16.092 l-0.177,0.177 a5.81,5.81 0 1,1 -8.215,-8.215 l0.159,-0.159"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M4,20 l3.5,-3.5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M15,4 l-3.5,3.5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M20,9 l-3.5,3.5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M3,3 l18,18"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>

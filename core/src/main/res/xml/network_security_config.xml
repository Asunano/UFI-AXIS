<?xml version="1.0" encoding="utf-8"?>
<!--
    允许对 localhost 的明文 HTTP 通信。
    aria2 JSON-RPC 运行在 127.0.0.1:6801，使用 HTTP（非 HTTPS），
    Android 9+ (API 28+) 默认禁止明文流量，需要显式放行。
-->
<network-security-config>
    <!-- 允许访问本机 aria2 RPC -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!--
        中国联通扫码登录：uac.10010.com 的 wologin/redi 会 302 到
        http://www.10010.com（明文），随后才落 JUT/商城会话。
        Android 9+ 默认拦截明文，表现为：
          UnknownServiceException: CLEARTEXT communication to www.10010.com not permitted
        只放行联通自己的域名，不全局开 usesCleartextTraffic。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10010.com</domain>
    </domain-config>

    <!--
        云上卡（物联卡）查询：ysv2.iot098.cn 只提供 HTTP，HTTPS 是腾讯云 CDN 证书，
        校验必失败。只放行这一个域名，不全局开 usesCleartextTraffic。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ysv2.iot098.cn</domain>
    </domain-config>

    <!--
        小鲸卡（物联卡）：xj.mywuliankj.cn 同样只提供 HTTP，HTTPS 握手失败。
        与云上卡同一套接口，只放行这一个域名。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">xj.mywuliankj.cn</domain>
    </domain-config>
</network-security-config>

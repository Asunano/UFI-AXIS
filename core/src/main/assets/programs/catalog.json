        "health": {
          "kind": "http",
          "path": "/rest/noauth/health",
          "accept_status": [200],
          "expect_contains": "OK",
          "timeout_ms": 2000,
          "interval_s": 30,
          "fail_threshold": 3,
          "startup_grace_s": 30,
          "startup_grace_max_s": 240,
          "stall_timeout_s": 90,
          "startup_grace_extend_max_s": 600
        },
        "stop": {
          "signal": "TERM",
          "grace_s": 10
        },
        "singleton": true,
        "storage": "internal"
      },
      "resources": {
        "rss_warn_mb": 160,
        "rss_restart_mb": 260,
        "rss_kill_mb": 400,
        "start_min_avail_mb": 200,
        "nice": 10,
        "data_quota_mb": 4096,
        "log_quota_mb": 32,
        "max_processes": 12
      },
      "restart": {
        "backoff_s": [5, 15, 60, 300, 900],
        "crash_loop_window_s": 120,
        "give_up_after": 8
      },
      "requires": {
        "privileged_port": false,
        "root": false,
        "network": "offline-ok",
        "private_data": true
      },
      "ui": {
        "open_path": "/",
        "title": "Syncthing"
      }
    },

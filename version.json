        "entry": "openlist",
        "abi": "arm64-v8a",
        "linkage": "android-dynamic"
      },
      "run": {
        "argv": [
          "server",
          "--data",
          "{DATA}"
        ],
        "env": {
          "TMPDIR": "{CACHE}",
          "HOME": "{DATA}"
        },
        "cwd": "{DATA}",
        "internal_port": 5244,
        "bind": "any",
        "external_port": 18080,
        "health": {
          "kind": "http",
          "path": "/ping",
          "accept_status": [
            200,
            401,
            403
          ],
          "expect_contains": "pong",
          "timeout_ms": 2000,
          "interval_s": 30,
          "fail_threshold": 3,
          "startup_grace_s": 30,
          "startup_grace_max_s": 240,
          "stall_timeout_s": 90,
          "startup_grace_extend_max_s": 600
        },
        "stop": {
          "signal": "TERM",
          "grace_s": 10
        },
        "singleton": true
      },
      "resources": {
        "rss_warn_mb": 128,
        "rss_restart_mb": 220,
        "rss_kill_mb": 360,
        "start_min_avail_mb": 200,
        "nice": 10,
        "data_quota_mb": 2048,
        "log_quota_mb": 32,
        "max_processes": 8
      },
      "restart": {
        "backoff_s": [
          5,
          15,
          60,
          300,
          900
        ],
        "crash_loop_window_s": 120,
        "give_up_after": 8
      },
      "requires": {
        "privileged_port": false,
        "root": false,
        "network": "online-only",
        "private_data": true
      },
      "content": {
        "enabled": true,
        "default_root": "internal",
        "required": false
      },
      "first_run": {
        "adapter": "openlist"
      },
      "ui": {
        "open_path": "/",
        "title": "OpenList"
      }
